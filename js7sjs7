--------------------------------------------------

local function applySize(s)
    s = math.clamp(s, 0.65, 1.35)
    uiScale.Scale = s

    local rel = (s - 0.65) / 0.70
    sliderFill.Size = UDim2.new(rel, 0, 1, 0)
    sliderBtn.Position = UDim2.new(rel, -7, 0.5, -7)
end

local dragging = false

local function updateSliderFromInput(input)
    local rel = math.clamp(
        (input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X,
        0, 1
    )
    applySize(0.65 + rel * 0.70)
end

sliderBtn.MouseButton1Down:Connect(function()
    dragging = true
end)

sliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
    then
        dragging = true
        updateSliderFromInput(input)
    end
end)

