--------------------------------------------------
-- CHECK GUI
--------------------------------------------------

local function isExternal(sg)
    if not sg then return false end
    if not (sg:IsA("ScreenGui") or sg:IsA("GuiMain")) then return false end

    local parent = sg.Parent
    if not parent then return false end
    if SKIP_NAMES[sg.Name] or SKIP_NAMES[parent.Name] then return false end

    return true
end

--------------------------------------------------
-- GET DISPLAY TEXT (cached)
--------------------------------------------------

local function getVisibleText(gui)
    if textCache[gui] \~= nil then
        return textCache[gui]
    end

    local best = nil
    local score = 0

    pcall(function()
        for _, obj in ipairs(gui:GetDescendants()) do
            if (obj:IsA("TextLabel") or obj:IsA("TextButton"))
                and obj.Visible
                and obj.AbsoluteSize.X > 20
            then
                local text = obj.Text
                if typeof(text) == "string" then
                    local trimmed = text:match("^%s*(.-)%s*$")
                    if trimmed and #trimmed >= 2 and #trimmed <= 40 then
                        local s = #trimmed
                        if obj:IsA("TextButton") then s = s + 20 end
                        if obj.TextSize >= 14 then s = s + 10 end

                        if s > score then
                            best = trimmed
                            score = s
                        end
                    end
                end
            end
        end
    end)

    textCache[gui] = best
    return best
end

--------------------------------------------------
-- COLLECT GUIS
--------------------------------------------------

local function collectGuis()
    local list = {}
    local seen = {}

    local containers = { CoreGui, HUI, PG }

    for _, container in ipairs(containers) do
        pcall(function()
            for _, child in ipairs(container:GetChildren()) do
                if not seen[child] and isExternal(child) then
                    seen[child] = true
                    table.insert(list, child)
                end
            end
        end)
    end

    return list
end

--------------------------------------------------
-- SEARCH MATCH
--------------------------------------------------

local function matchesSearch(gui)
    if currentSearch == "" then return true end

    local visible = getVisibleText(gui)
    local display = visible or gui.Name
    local text = string.lower(tostring(display) .. " " .. tostring(gui.Name))
    local query = string.lower(currentSearch)

    return string.find(text, query, 1, true) \~= nil
end

