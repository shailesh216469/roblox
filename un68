--------------------------------------------------

local function sortList(list)

    if SORT_MODE == "A-Z" then

        table.sort(
            list,
            function(a, b)

                return a.Name:lower()
                    < b.Name:lower()
            end
        )

    elseif SORT_MODE == "Z-A" then

        table.sort(
            list,
            function(a, b)

                return a.Name:lower()
                    > b.Name:lower()
            end
        )

    else

        table.sort(
            list,
            function(a, b)

                return
                    (latestGuis[a] or 0)
                    >
                    (latestGuis[b] or 0)
            end
        )
    end
end

--------------------------------------------------
-- REFRESH
--------------------------------------------------

local refreshing =
    false

local function refresh(
    keepScroll
)

    if refreshing then
        return
    end

    refreshing = true

    local oldScroll =
        keepScroll
        and scroll.CanvasPosition
        or Vector2.new(
            0,
            0
        )

    --------------------------------------------------
    -- CLEAR LIST
    --------------------------------------------------

    for _, child in ipairs(
        scroll:GetChildren()
    ) do

        if
            child:IsA("Frame")
            or child:IsA("TextLabel")
        then

            child:Destroy()
        end
    end

    --------------------------------------------------
    -- COLLECT
    --------------------------------------------------

    local guis =
        collectGuis()

    local now =
        tick()

    local current =
        {}

    --------------------------------------------------
    -- TRACK NEW
    --------------------------------------------------

    for _, gui in ipairs(guis) do

        current[gui] =
            true

        if not knownGuis[gui] then

            knownGuis[gui] =
                true

            latestGuis[gui] =
                now

            textCache[gui] =
                nil
        end
    end

    --------------------------------------------------
    -- REMOVE DEAD
    --------------------------------------------------

    for gui in pairs(
        knownGuis
    ) do

        if
            not current[gui]
            or not gui.Parent
        then

            knownGuis[gui] =
                nil

            latestGuis[gui] =
                nil

            textCache[gui] =
                nil
        end
    end

    --------------------------------------------------
    -- SPLIT
    --------------------------------------------------

    local normalList =
        {}

    local latestList =
        {}

    for _, gui in ipairs(
        guis
    ) do

        local created =
            latestGuis[gui]

        if
            created
            and
            now - created
                <= LATEST_WINDOW
        then

            table.insert(
                latestList,
                gui
            )

        else

            table.insert(
                normalList,
                gui
            )
        end
    end

    sortList(
        normalList
    )

    sortList(
        latestList
    )

    --------------------------------------------------
    -- DISPLAY
    --------------------------------------------------

    local showing =
        0

    for _, gui in ipairs(
        normalList
    ) do

        if createRow(
            gui,
            false
        ) then

            showing += 1
        end
    end

    if #latestList > 0 then

        createHeader(
            "Latest ("
            .. #latestList
            .. ")"
        )

        for _, gui in ipairs(
            latestList
        ) do

            if createRow(
                gui,
                true
            ) then

                showing += 1
            end
        end
    end

    status.Text =
        string.format(
            "Found: %d | Showing: %d",
            #guis,
            showing
        )

    --------------------------------------------------
    -- RESTORE SCROLL
    --------------------------------------------------

    if keepScroll then

        task.defer(
            function()

                pcall(function()

                    scroll.CanvasPosition =
                        oldScroll

                end)
            end
        )
    end

    refreshing =
        false
end

