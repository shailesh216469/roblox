local function removeHighlights()

    pcall(function()

        for _, obj in ipairs(
            HUI:GetChildren()
        ) do

            if obj.Name ==
                "ExtGuiMgr_Highlight"
            then
                obj:Destroy()
            end
        end
    end)

    pcall(function()

        for _, obj in ipairs(
            CoreGui:GetChildren()
        ) do

            if obj.Name ==
                "ExtGuiMgr_Highlight"
            then
                obj:Destroy()
            end
        end
    end)
end

--------------------------------------------------
-- HIGHLIGHT
--------------------------------------------------

local function highlightGui(target)

    if not target
        or not target.Parent
    then
        return
    end

    removeHighlights()

    local visible =
        getVisibleText(target)

    local display =
        visible or target.Name

    local overlay =
        Instance.new("ScreenGui")

    overlay.Name =
        "ExtGuiMgr_Highlight"

    overlay.IgnoreGuiInset =
        true

    overlay.DisplayOrder =
        1000001

    safeParent(overlay)

    local visual = target
    local maxArea = 0

    pcall(function()

        for _, obj in ipairs(
            target:GetDescendants()
        ) do

            if
                obj:IsA("GuiObject")
                and obj.Visible
            then

                local area =
                    obj.AbsoluteSize.X
                    * obj.AbsoluteSize.Y

                if area > maxArea then

                    maxArea = area
                    visual = obj

                end
            end
        end
    end)

    local size =
        visual.AbsoluteSize

    local position =
        visual.AbsolutePosition

    if
        size.X > 40
        and size.Y > 20
    then

        local box =
            Instance.new("Frame")

        box.Parent =
            overlay

        box.BackgroundColor3 =
            Color3.fromRGB(
                0,
                255,
                255
            )

        box.BackgroundTransparency =
            0.55

        box.BorderSizePixel =
            0

        box.Size =
            UDim2.fromOffset(
                size.X + 14,
                size.Y + 14
            )

        box.Position =
            UDim2.fromOffset(
                position.X - 7,
                position.Y - 7
            )

        local stroke =
            Instance.new("UIStroke")

        stroke.Parent =
            box

        stroke.Thickness =
            4

        stroke.Color =
            Color3.fromRGB(
                255,
                50,
                50
            )

        local label =
            Instance.new("TextLabel")

        label.Parent =
            overlay

        label.Size =
            UDim2.fromOffset(
                math.clamp(
                    size.X + 14,
                    160,
                    400
                ),
                28
            )

        label.BackgroundColor3 =
            Color3.fromRGB(
                0,
                0,
                0
            )

        label.BackgroundTransparency =
            0.2

        label.Text =
            display

        label.TextColor3 =
            Color3.fromRGB(
                255,
                255,
                80
            )

        label.Font =
            Enum.Font.GothamBold

        label.TextSize =
            14

        label.TextTruncate =
            Enum.TextTruncate.AtEnd

        Instance.new(
            "UICorner",
            label
        ).CornerRadius =
            UDim.new(0, 4)

        local camera =
            workspace.CurrentCamera

        local screenSize =
            camera
            and camera.ViewportSize
            or Vector2.new(
                1920,
                1080
            )

        local lx =
            position.X - 7

        local ly =
            position.Y - 36

        if ly < 5 then

            ly =
                position.Y
                + size.Y
                + 10
        end

        if lx < 5 then
            lx = 5
        end

        local width =
            label.Size.X.Offset

        if
            lx + width
            > screenSize.X - 5
        then

            lx =
                screenSize.X
                - width
                - 5
        end

        label.Position =
            UDim2.fromOffset(
                lx,
                ly
            )

    else

        local background =
            Instance.new("Frame")

        background.Parent =
            overlay

        background.Size =
            UDim2.fromScale(
                1,
                1
            )

        background.BackgroundColor3 =
            Color3.fromRGB(
                0,
                200,
                255
            )

        background.BackgroundTransparency =
            0.72

        local label =
            Instance.new("TextLabel")

        label.Parent =
            overlay

        label.Size =
            UDim2.new(
                0.85,
                0,
                0,
                70
            )

        label.Position =
            UDim2.new(
                0.075,
                0,
                0.4,
                0
            )

        label.BackgroundColor3 =
            Color3.fromRGB(
                0,
                0,
                0
            )

        label.BackgroundTransparency =
            0.25

        label.Text =
            "HIGHLIGHTING\n"
            .. display

        label.TextColor3 =
            Color3.fromRGB(
                255,
                255,
                80
            )

        label.Font =
            Enum.Font.GothamBold

        label.TextSize =
            20

        label.TextWrapped =
            true

        Instance.new(
            "UICorner",
            label
        ).CornerRadius =
            UDim.new(0, 8)
    end

    task.delay(
        3,
        function()

            pcall(function()

                if
                    overlay
                    and overlay.Parent
                then
                    overlay:Destroy()
                end
            end)
        end
    )
end

