--------------------------------------------------
-- HIDDEN GUI SUPPORT
--------------------------------------------------

local function getHiddenUI()
    local ok, result = pcall(function()

        if typeof(gethui) == "function" then
            return gethui()
        end

        if typeof(get_hidden_gui) == "function" then
            return get_hidden_gui()
        end

        return CoreGui
    end)

    if ok and result then
        return result
    end

    return CoreGui
end

local HUI = getHiddenUI()

--------------------------------------------------
-- SAFE PARENT
--------------------------------------------------

local function safeParent(gui)

    pcall(function()
        if syn and syn.protect_gui then
            syn.protect_gui(gui)
        end
    end)

    pcall(function()
        gui.Parent = HUI
    end)

    if not gui.Parent then
        pcall(function()
            gui.Parent = CoreGui
        end)
    end

    if not gui.Parent then
        pcall(function()
            gui.Parent = PG
        end)
    end
end

